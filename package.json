{
  "name": "cloudonym",
  "private": true,
  "license": "Apache-2.0",
  "version": "0.1.11",
  "type": "module",
  "bin": {
    "cloudonym": "cli/cloudonym.mjs"
  },
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/gen-intro-examples.mjs",
    "build": "tsc -b && vite build && node scripts/check-bundle.mjs",
    "lint": "oxlint",
    "preview": "npm run build && vite preview",
    "deploy": "npm run build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "test": "vitest run",
    "test:rules": "node --test scripts/rules/*.test.mjs scripts/catalog/*.test.mjs",
    "test:cli": "node --test cli/*.test.mjs",
    "cli": "node cli/cloudonym.mjs",
    "build:cli-bin": "node scripts/cli-sea.mjs",
    "catalog": "node scripts/catalog/build-catalog.mjs",
    "intro-examples": "node scripts/gen-intro-examples.mjs",
    "typecheck": "tsc -b --noEmit"
  },
  "dependencies": {
    "hono": "^4.13.9",
    "lucide-react": "^1.48.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.61.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "ajv": "^8.20.0",
    "oxlint": "^1.81.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.2",
    "wrangler": "^4.142.0"
  }
}
