/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "cloudonym",
	"main": "src/api/index.ts",
	"compatibility_date": "2026-09-25",
	// workers.dev 주소는 끈다 (D106) — 켜 두면 같은 화면이 두 주소에서 열리고 각자 자기를 canonical 로 내세운다. 커스텀 도메인은 이 설정과 무관하다
	"workers_dev": false,
	"assets": {
		// 화면 경로의 HTML 은 Worker 가 만든다 (D106) — 경로마다 head, 모르는 경로는 404. 정적 파일이 없는 경로는 Worker 로 가고(not_found_handling none),
		// 파일이 있는 뿌리 `/`(index.html)와 Worker 경로는 run_worker_first 로 먼저 받는다. Worker 는 ASSETS 바인딩으로 index.html 을 읽는다
		"binding": "ASSETS",
		"not_found_handling": "none",
		"run_worker_first": ["/", "/v1/*", "/llms.txt", "/catalog.json", "/robots.txt", "/sitemap.xml"]
	},
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	/**
	 * Smart Placement
	 * https://developers.cloudflare.com/workers/configuration/smart-placement/#smart-placement
	 */
	// "placement": {  "mode": "smart" }
	/**
	 * Bindings
	 * Bindings allow your Worker to interact with resources on the Cloudflare Developer Platform, including
	 * databases, object storage, AI inference, real-time communication and more.
	 * https://developers.cloudflare.com/workers/runtime-apis/bindings/
	 */
	// 요청 제한 — 클라이언트 IP 당 60 초에 60 건. POST /v1/* 와 GET /llms.txt · GET /catalog.json 을 센다(src/api/ratelimit.ts).
	// period 는 10 또는 60 만 된다. namespace_id 는 계정 안에서 고유한 양의 정수 문자열이다
	// https://developers.cloudflare.com/workers/runtime-apis/bindings/rate-limit/
	"ratelimits": [
		{ "name": "API_LIMITER", "namespace_id": "1001", "simple": { "limit": 60, "period": 60 } }
	],
	// KV — 사용 카운터(일자 키 · 366일 뒤 만료). `wrangler kv namespace create CLOUDONYM_KV` 로 만든 이름공간이다 — id 는 비밀이 아니다
	"kv_namespaces": [ { "binding": "CLOUDONYM_KV", "id": "1339df170873499ebc0d2cf1c29ec5f2" } ],
	/**
	 * Environment Variables
	 * https://developers.cloudflare.com/workers/wrangler/configuration/#environment-variables
	 * Note: Use secrets to store sensitive data.
	 * https://developers.cloudflare.com/workers/configuration/secrets/
	 */
	// Axiom 데이터셋 이름 — 비밀이 아니라 vars 에 둔다. 토큰은 `wrangler secret put AXIOM_API_KEY`(없으면 Axiom 으로 보내지 않는다).
	// 데이터셋의 보존 기간을 정하면 src/components/privacyModel.ts 의 PRIVACY_AXIOM_RETENTION_DAYS 에 같은 값을 적는다(/privacy 안내)
	// 검색 엔진 소유 확인 값 (D120) — 공개용 확인 토큰이라 비밀이 아니다. 네이버는 `/` 의 head 메타, Daum 은 robots.txt 끝 줄,
	// IndexNow 키는 `/<키>.txt` 로 Worker 가 낸다(정적 파일이 없는 경로라 not_found_handling none 으로 Worker 에 온다). 비우면 내지 않는다
	"vars": {
		"AXIOM_DATASET": "cloudonym",
		"NAVER_SITE_VERIFICATION": "840adcf594babcee8a5e7afd9cf3ae927f671b14",
		"DAUM_WEBMASTER_LINE": "#DaumWebMasterTool:2aba08c8ccc90a30747fb8745790df3d0f2adb237bf1be270d08eeb290062b2b:nmRPv+AMqgHpYd33WRjhZA==",
		"INDEXNOW_KEY": "49099bb7655296b243ab6ad364e69237"
	},
	/**
	 * Service Bindings (communicate between multiple Workers)
	 * https://developers.cloudflare.com/workers/wrangler/configuration/#service-bindings
	 */
	// "services": [  {   "binding": "MY_SERVICE",   "service": "my-service"  } ]
}